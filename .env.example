# --- LLM provider (any OpenAI-compatible endpoint works) ---
OPENAI_API_KEY=your-api-key-here
# Optional: point Synapse at DeepSeek / Qwen / GLM / OpenRouter / Ollama etc.
# SYNAPSE_LLM_BASE_URL=https://api.deepseek.com/v1
# SYNAPSE_MODEL=gpt-4o-mini

# --- Agent loop ---
# Max LLM rounds per query (1 = legacy single-shot routing)
# SYNAPSE_MAX_STEPS=5
# SYNAPSE_TEMPERATURE=0.2
# SYNAPSE_LLM_TIMEOUT=60

# --- Self-evolution ---
# Voyager-style generate->validate->repair rounds per new skill
# SYNAPSE_GENERATE_MAX_ATTEMPTS=3
# Auto-repair a skill after N consecutive failures (0 = disable)
# SYNAPSE_AUTO_REPAIR=1
# SYNAPSE_AUTO_REPAIR_THRESHOLD=3

# --- Storage / observability ---
# SYNAPSE_MEMORY_PATH=data/memory.json
# SYNAPSE_REGISTRY_PATH=data/skill_registry.json
# SYNAPSE_TRACE=1
# SYNAPSE_TRACE_PATH=data/traces.jsonl
